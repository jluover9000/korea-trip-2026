{"title":"Jul 28 — Gangnam Day","markdown":{"yaml":{"title":"Jul 28 — Gangnam Day"},"containsRefs":false,"markdown":"\n\n```{=html}\n<div class=\"day-hero\">\n  <div class=\"day-badge\">Tuesday · July 28, 2026 · Day 3 of 15</div>\n  <h1 class=\"day-title\">Gangnam Day 💅</h1>\n  <div class=\"day-subtitle\">📍 Mangwon · Garosugil · Sinsa · Gangnam · Seoul</div>\n</div>\n```\n\n```{=html}\n<div id=\"map-jul28\" class=\"day-map\"></div>\n<script>\n(function() {\n  var map = L.map('map-jul28').setView([37.5300, 126.9900], 12);\n  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n    attribution: '© <a href=\"https://www.openstreetmap.org/copyright\">OSM</a>'\n  }).addTo(map);\n  function dot(c) {\n    return L.divIcon({ className:'', html:'<div style=\"width:13px;height:13px;border-radius:50%;background:'+c+';border:2.5px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.4)\"></div>', iconSize:[13,13], iconAnchor:[6,6], popupAnchor:[0,-8] });\n  }\n  function hotelDot() {\n    return L.divIcon({ className:'', html:'<div style=\"width:22px;height:22px;border-radius:50%;background:#4A148C;border:2.5px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;font-size:12px;line-height:1;color:#fff\">★</div>', iconSize:[22,22], iconAnchor:[11,11], popupAnchor:[0,-13] });\n  }\n  var pts = [\n    { name:'🏨 Shilla Stay Seodaemun Seoul Station', lat:37.5572, lng:126.9680, hotel:true, url:'https://www.google.com/maps/search/?api=1&query=Shilla+Stay+Seodaemun+Seoul+Station' },\n    { name:'VIC Lab Color Analysis 🎨 (Booked)', lat:37.5585, lng:126.9209, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=15+World+Cup+buk-ro+4-gil' },\n    { name:'Mangwon Market 🍜', lat:37.5551, lng:126.9046, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Mangwon+Market+Seoul', hours:'9:00 AM – 9:00 PM' },\n    { name:'Tamburins Flagship 🧴',lat:37.5209, lng:127.0221, c:'#00897B', url:'https://www.google.com/maps/search/?api=1&query=Tamburins+flagship+Sinsa+Seoul' },\n    { name:'Hair Tattoo Appointment 💇', lat:37.5220, lng:127.0279, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=hair+tattoo+salon+Gangnam+Seoul' },\n    { name:'Gebang Sikdang 🦀 (Soy Crab)', lat:37.51764326285173, lng:127.03941658573348, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Gebang+Sikdang+Seoul', hours:'11:30–21:00 (break 15:00–17:30)' },\n    { name:'Sappun Shoes 👟', lat:37.5203, lng:127.0225, c:'#EC407A', url:'https://share.google/1W5iNuG4JvJBuEQan' },\n    { name: 'Blue Elephant', lat:37.5252, lng:127.03661, c:'#EC407A', url:'https://maps.app.goo.gl/CrmhGn5exhUnqFXo7'},\n    { name: 'Rockfish Weatherwear Dosan', lat:37.5254, lng:127.0373, c:'#EC407A', url:'https://maps.app.goo.gl/Zw6ppFTFKxw6nPtx8'},\n    { name: 'Osoi', lat:37.5465, lng:127.05104, c:'#EC407A', url: 'https://maps.app.goo.gl/Yr9idjP7AJjC1CnS6'},\n    { name: 'DOUBLE LOVERS SEONGSU FLAGSHIP STORE', lat:37.5437, lng:127.0548, c:'#ec40aa', url: 'https://maps.app.goo.gl/YzPU8Qo1fnScC3Rk7'},\n    { name: 'MARGESHERWOOD Seoul Flagship Store', lat:37.5435, lng:127.0572, c:'#ec40aa', url: 'https://maps.app.goo.gl/M6kusS5gXj8dnZQz6'},\n    { name: 'STAND OIL', lat:37.54398875947829, lng:127.05746441492252, c:'#ec40aa', url: 'https://maps.app.goo.gl/xS5Hjpgqxg6qB4dY8'},\n    { name: 'Muguok 🍗 (Samgyetang)', lat:37.57655560914056, lng:126.97995930859655, c:'#43A047', url: 'https://maps.app.goo.gl/qdP7xa4t58aPvJHq5'},\n  ];\n  window.pageMap = map; window.pageMarkers = [];\n  pts.forEach(function(p) {\n    var m = L.marker([p.lat, p.lng], { icon: p.hotel ? hotelDot() : dot(p.c) }).addTo(map);\n    var html = '<b>' + p.name + '</b>';\n    if (p.hours) html += '<br><span style=\"font-size:12px\">🕐 ' + p.hours + '</span>';\n    if (p.url) html += '<br><a href=\"' + p.url + '\" target=\"_blank\" style=\"font-size:12px\">Open in Maps →</a>';\n    m.bindPopup(html);\n    window.pageMarkers.push({ marker: m, lat: p.lat, lng: p.lng });\n  });\n  function routeLabel(n, color) {\n    return L.divIcon({ className:'', html:'<div style=\"width:18px;height:18px;border-radius:50%;background:'+color+';border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;line-height:1\">'+n+'</div>', iconSize:[18,18], iconAnchor:[9,9] });\n  }\n  // Route 1: Shilla Stay → VIC Lab\n  L.polyline([[37.5572,126.9680],[37.5585,126.9209]], { color:'#4A148C', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5579,126.9445], { icon:routeLabel(1,'#4A148C') }).addTo(map);\n  // Route 2: VIC Lab → Mangwon Market\n  L.polyline([[37.5585,126.9209],[37.5551,126.9046]], { color:'#1565C0', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5568,126.9128], { icon:routeLabel(2,'#1565C0') }).addTo(map);\n  // Route 3: Mangwon Market → Muguok\n  L.polyline([[37.5551,126.9046],[37.5766,126.9800]], { color:'#00897B', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5658,126.9423], { icon:routeLabel(3,'#00897B') }).addTo(map);\n  // Route 4: Muguok → Seongsu cluster (Osoi / Double Lovers / MARGESHERWOOD / STAND OIL)\n  L.polyline([[37.5766,126.9800],[37.5440,127.0550]], { color:'#E65100', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5603,127.0175], { icon:routeLabel(4,'#E65100') }).addTo(map);\n  // Route 5: Seongsu cluster → Sinsa / Garosugil (transit)\n  L.polyline([[37.5440,127.0550],[37.5209,127.0221]], { color:'#6A1B9A', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5325,127.0386], { icon:routeLabel(5,'#6A1B9A') }).addTo(map);\n  // Route 6: Sinsa / Garosugil → Gebang Sikdang\n  L.polyline([[37.5209,127.0221],[37.5176,127.0394]], { color:'#B71C1C', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5193,127.0308], { icon:routeLabel(6,'#B71C1C') }).addTo(map);\n})();\n</script>\n```\n\n```{=html}\n<div class=\"section-header\">Morning</div>\n\n<div class=\"event-card meal\" style=\"border-color:#F9A825;background:#FFFDE7\" data-dt=\"2026-07-28T07:00\" data-lat=\"37.5572\" data-lng=\"126.9680\">\n  <div class=\"event-time\">07:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🍳 Breakfast</span></div>\n    <div class=\"event-name\">Breakfast Buffet · CAFE (B1F) · Shilla Stay</div>\n    <div class=\"event-notes\">Weekday hours: <strong>06:30–09:30</strong> · ₩23,000/adult · COVA coffee, croissants, Korean &amp; Western hot dishes. Arrive by <strong>09:00</strong> at the latest — staff strictly enforce closing time.</div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-28T09:30\" data-lat=\"37.5585\" data-lng=\"126.9209\">\n  <div class=\"event-time\">09:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag booked\">BOOKED ✓</span><span class=\"tag activity\">🎨 Activity</span></div>\n    <div class=\"event-name\">VIC Lab — Personal Color Analysis</div>\n    <div class=\"event-notes\">Discover your personal colour season (Spring Warm, Summer Cool, etc.) through professional draping analysis. Bring an open mind and minimal makeup for accurate results.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=VIC+Lab+Color+Analysis+Gangnam+Seoul\" target=\"_blank\" class=\"maps-link\">📍 VIC Lab</a>\n      <a href=\"https://map.naver.com/p/search/VIC+LAB+강남\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"event-card transit\" data-dt=\"2026-07-28T10:45\">\n  <div class=\"event-time\">→</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🚶 Getting There</span></div>\n    <div class=\"event-name\">VIC Lab → Mangwon Market</div>\n    <div class=\"event-notes\">\n      <strong>Option A — Walk</strong> · 1.6 km · ~25 min · enjoy the neighbourhood along the way<br>\n      <strong>Option B — Bus</strong> · ~20 min total · 8 min walk to bus stop → 8 min bus ride → 4 min walk to market\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Lunch — Mangwon Market</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-28T11:30\" data-lat=\"37.5551\" data-lng=\"126.9046\">\n  <div class=\"event-time\">11:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍜 Lunch</span></div>\n    <div class=\"event-name\">Mangwon Market</div>\n    <div class=\"event-notes\"><strong>Hours: 9:00 AM – 9:00 PM</strong><br>Local covered market with great food stalls. Try:\n      <ul>\n        <li>Dakgomtang — herbal chicken soup stall</li>\n        <li>Korean meat balls (고기완자)</li>\n        <li>Twisted donut (꽈배기)</li>\n        <li>Hotteok — sweet syrup-filled pancake (호떡)</li>\n      </ul>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Mangwon+Market+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Mangwon Market</a>\n      <a href=\"https://map.naver.com/p/search/망원시장\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"event-card transit\" data-dt=\"2026-07-28T12:30\">\n  <div class=\"event-time\">→</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🚇 Getting There · ~1 hr</span></div>\n    <div class=\"event-name\">Mangwon Market → Sinsa (Garosugil)</div>\n    <div class=\"event-notes\">\n      <strong>① Walk</strong> 1.3 km · ~21 min to subway station<br>\n      <strong>② Line 2</strong> <span style=\"display:inline-block;background:#3AB34A;color:#fff;padding:1px 7px;border-radius:3px;font-size:11px;font-weight:700\">Green</span> · ~14 min<br>\n      <strong>③ Transfer at Euljiro 3-ga</strong> → Line 3 <span style=\"display:inline-block;background:#F7931D;color:#fff;padding:1px 7px;border-radius:3px;font-size:11px;font-weight:700\">Orange</span><br>\n      <strong>④ Alight at Sinsa Station</strong>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-28T13:00\" data-lat=\"37.57655560914056\" data-lng=\"126.97995930859655\">\n  <div class=\"event-time\">13:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍗 Lunch</span></div>\n    <div class=\"event-name\">Muguok — MUST TRY!</div>\n    <div class=\"event-notes\">\n      <ul>\n        <li>Samgyetang (삼계탕) — ginseng chicken soup</li>\n        <li>Personal ginseng chicken set recommended</li>\n      </ul>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://maps.app.goo.gl/qdP7xa4t58aPvJHq5\" target=\"_blank\" class=\"maps-link\">📍 Muguok</a>\n      <a href=\"https://map.naver.com/p/search/무국삼계탕+서울\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Afternoon — Shopping</div>\n\n<div class=\"event-card shopping\" data-dt=\"2026-07-28T13:30\">\n  <div class=\"event-time\">First</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag shopping\">🛍️ Stop 1 · Near Sinsa Station</span></div>\n    <div class=\"event-name\">Tamburins Flagship · Sappun Garosugil Branch</div>\n    <div class=\"event-notes\">Right off the station — start here before moving west.\n      <ul>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Tamburins+flagship+Sinsa+Seoul\" target=\"_blank\">Tamburins flagship store, Sinsa</a></li>\n        <li><a href=\"https://share.google/1W5iNuG4JvJBuEQan\" target=\"_blank\">Sappun Garosugil Branch</a></li>\n      </ul>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card transit\" data-dt=\"2026-07-28T14:15\">\n  <div class=\"event-time\">→</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🚶 Getting There</span></div>\n    <div class=\"event-name\">Sinsa → Rockfish / Blue Elephant area (Dosan)</div>\n    <div class=\"event-notes\">\n      <strong>Option A — Walk</strong> · 1.7 km · ~30 min<br>\n      <strong>Option B — Bus</strong> · ~20 min\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card shopping\" data-dt=\"2026-07-28T14:30\">\n  <div class=\"event-time\">Stop 2</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag shopping\">🛍️ Stop 2 · Dosan area</span></div>\n    <div class=\"event-name\">Rockfish Weatherwear · Blue Elephant</div>\n    <div class=\"event-notes\">These two are right next to each other.\n      <ul>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Rockfish+Weatherwear+Dosan+Seoul\" target=\"_blank\">Rockfish Weatherwear Dosan</a></li>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Blue+Elephant+Dosan+Seoul\" target=\"_blank\">Blue Elephant</a></li>\n      </ul>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card transit\" data-dt=\"2026-07-28T15:15\">\n  <div class=\"event-time\">→</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🚇 1 Stop · ~20 min walk after</span></div>\n    <div class=\"event-name\">Dosan → Double Lovers / Stand Oil / MARGESHERWOOD cluster</div>\n    <div class=\"event-notes\">Take 1 subway stop then walk ~20 min. All three stores are clustered very close together.</div>\n  </div>\n</div>\n\n<div class=\"event-card shopping\" data-dt=\"2026-07-28T15:30\">\n  <div class=\"event-time\">Stop 3</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag shopping\">🛍️ Stop 3 · Clustered</span></div>\n    <div class=\"event-name\">Double Lovers · Stand Oil · MARGESHERWOOD</div>\n    <div class=\"event-notes\">All within a short walk of each other.\n      <ul>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Double+Lovers+Seoul\" target=\"_blank\">Double Lovers</a></li>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Stand+Oil+Seoul\" target=\"_blank\">Stand Oil</a></li>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Margesherwood+Seoul\" target=\"_blank\">MARGESHERWOOD</a></li>\n      </ul>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card shopping\" data-dt=\"2026-07-28T16:00\">\n  <div class=\"event-time\">Stop 4</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag shopping\">🛍️ Stop 4 · Nearby</span></div>\n    <div class=\"event-name\">Osoi</div>\n    <div class=\"event-notes\">A few blocks from the Stop 3 cluster.\n      <ul>\n        <li><a href=\"https://www.google.com/maps/search/?api=1&query=Osoi+Seoul\" target=\"_blank\">Osoi</a></li>\n      </ul>\n    </div>\n  </div>\n</div>\n\n\n<div class=\"event-card morning\" data-dt=\"2026-07-28T16:30\" data-lat=\"37.5220\" data-lng=\"127.0279\">\n  <div class=\"event-time\">16:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag booked\">BOOKED ✓</span><span class=\"tag activity\">💇 Appointment</span></div>\n    <div class=\"event-name\">Hair Tattoo Appointment</div>\n    <div class=\"event-notes\">Scalp hair tattoo / micropigmentation appointment. Allow ~2 hours.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=hair+tattoo+scalp+Gangnam+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gangnam Area</a>\n      <a href=\"https://map.naver.com/p/search/헤어+타투+강남\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Dinner</div>\n<div class=\"event-card meal\" data-dt=\"2026-07-28T18:30\" data-lat=\"37.517427101564024\" data-lng=\"127.03950010859656\">\n  <div class=\"event-time\">18:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🦀 Dinner</span><span class=\"tag booked\">BOOKED ✓</span></div>\n    <div class=\"event-name\">Gebang Sikdang — Soy Marinated Crab</div>\n    <div class=\"event-notes\">🕐 <strong>11:30–21:00</strong> · Break time 15:00–17:30<br>Ganjang gejang (간장 게장) — raw crab marinated in soy sauce. Rich, umami-packed, melt-in-your-mouth.<br><strong>Reservation at 6:30 PM under Celina So.</strong></div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gebang+Sikdang+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gebang Sikdang</a>\n      <a href=\"https://map.naver.com/p/search/게방식당\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n```\n\n\n```{=html}\n<div class=\"note-box\"><strong>Breakfast included</strong> at hotel. · Today's big spend: colour analysis + hair + crab dinner — budget accordingly.</div>\n```\n","srcMarkdownNoYaml":"\n\n```{=html}\n<div class=\"day-hero\">\n  <div class=\"day-badge\">Tuesday · July 28, 2026 · Day 3 of 15</div>\n  <h1 class=\"day-title\">Gangnam Day 💅</h1>\n  <div class=\"day-subtitle\">📍 Mangwon · Garosugil · Sinsa · Gangnam · Seoul</div>\n</div>\n```\n\n```{=html}\n<div id=\"map-jul28\" class=\"day-map\"></div>\n<script>\n(function() {\n  var map = L.map('map-jul28').setView([37.5300, 126.9900], 12);\n  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n    attribution: '© <a href=\"https://www.openstreetmap.org/copyright\">OSM</a>'\n  }).addTo(map);\n  function dot(c) {\n    return L.divIcon({ className:'', html:'<div style=\"width:13px;height:13px;border-radius:50%;background:'+c+';border:2.5px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.4)\"></div>', iconSize:[13,13], iconAnchor:[6,6], popupAnchor:[0,-8] });\n  }\n  function hotelDot() {\n    return L.divIcon({ className:'', html:'<div style=\"width:22px;height:22px;border-radius:50%;background:#4A148C;border:2.5px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;font-size:12px;line-height:1;color:#fff\">★</div>', iconSize:[22,22], iconAnchor:[11,11], popupAnchor:[0,-13] });\n  }\n  var pts = [\n    { name:'🏨 Shilla Stay Seodaemun Seoul Station', lat:37.5572, lng:126.9680, hotel:true, url:'https://www.google.com/maps/search/?api=1&query=Shilla+Stay+Seodaemun+Seoul+Station' },\n    { name:'VIC Lab Color Analysis 🎨 (Booked)', lat:37.5585, lng:126.9209, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=15+World+Cup+buk-ro+4-gil' },\n    { name:'Mangwon Market 🍜', lat:37.5551, lng:126.9046, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Mangwon+Market+Seoul', hours:'9:00 AM – 9:00 PM' },\n    { name:'Tamburins Flagship 🧴',lat:37.5209, lng:127.0221, c:'#00897B', url:'https://www.google.com/maps/search/?api=1&query=Tamburins+flagship+Sinsa+Seoul' },\n    { name:'Hair Tattoo Appointment 💇', lat:37.5220, lng:127.0279, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=hair+tattoo+salon+Gangnam+Seoul' },\n    { name:'Gebang Sikdang 🦀 (Soy Crab)', lat:37.51764326285173, lng:127.03941658573348, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Gebang+Sikdang+Seoul', hours:'11:30–21:00 (break 15:00–17:30)' },\n    { name:'Sappun Shoes 👟', lat:37.5203, lng:127.0225, c:'#EC407A', url:'https://share.google/1W5iNuG4JvJBuEQan' },\n    { name: 'Blue Elephant', lat:37.5252, lng:127.03661, c:'#EC407A', url:'https://maps.app.goo.gl/CrmhGn5exhUnqFXo7'},\n    { name: 'Rockfish Weatherwear Dosan', lat:37.5254, lng:127.0373, c:'#EC407A', url:'https://maps.app.goo.gl/Zw6ppFTFKxw6nPtx8'},\n    { name: 'Osoi', lat:37.5465, lng:127.05104, c:'#EC407A', url: 'https://maps.app.goo.gl/Yr9idjP7AJjC1CnS6'},\n    { name: 'DOUBLE LOVERS SEONGSU FLAGSHIP STORE', lat:37.5437, lng:127.0548, c:'#ec40aa', url: 'https://maps.app.goo.gl/YzPU8Qo1fnScC3Rk7'},\n    { name: 'MARGESHERWOOD Seoul Flagship Store', lat:37.5435, lng:127.0572, c:'#ec40aa', url: 'https://maps.app.goo.