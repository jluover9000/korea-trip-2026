782932536, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=Anmok+Haeundae+Busan' },\n  ];\n  window.pageMap = map; window.pageMarkers = [];\n  pts.forEach(function(p) {\n    var m = L.marker([p.lat, p.lng], { icon: p.hotel ? hotelDot() : dot(p.c) }).addTo(map);\n    var html = '<b>' + p.name + '</b>';\n    if (p.url) html += '<br><a href=\"' + p.url + '\" target=\"_blank\" style=\"font-size:12px\">Open in Maps →</a>';\n    m.bindPopup(html);\n    window.pageMarkers.push({ marker: m, lat: p.lat, lng: p.lng });\n  });\n})();\n</script>\n```\n\n```{=html}\n<div class=\"section-header\">Morning — Departure</div>\n\n<div class=\"event-card meal\" style=\"border-color:#F9A825;background:#FFFDE7\" data-dt=\"2026-08-04T06:30\" data-lat=\"33.48580289503151\" data-lng=\"126.49091012883574\">\n  <div class=\"event-time\">06:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🍳 Breakfast</span></div>\n    <div class=\"event-name\">Breakfast Buffet · Cafe (12F) · Shilla Stay Jeju Airport</div>\n    <div class=\"event-notes\"><strong>Weekday hours: 06:30–09:30</strong> · Last morning at the hotel — eat early to leave time before the flight.</div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-08-04T08:30\">\n  <div class=\"event-time\">08:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚗 Return Car</span></div>\n    <div class=\"event-name\">Check Out · Return Rental Car — Jeju One Car</div>\n    <div class=\"event-notes\">Check out of Shilla Stay Jeju Airport. Return rental car to Jeju One Car near the airport — quick drop-off since it's right next door.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Jeju+International+Airport\" target=\"_blank\" class=\"maps-link\">📍 Jeju Airport</a>\n      <a href=\"https://map.naver.com/p/search/제주국제공항\" target=\"_blank\" class=\"maps-link naver-link\">