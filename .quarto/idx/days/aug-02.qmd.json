d morning\" data-dt=\"2026-08-02T09:00\" data-lat=\"33.5280\" data-lng=\"126.7718\">\n  <div class=\"event-time\">09:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🕍 Cave</span><span class=\"tag note\">⚠️ Check Status</span></div>\n    <div class=\"event-name\">Manjanggul Lava Tube Cave</div>\n    <div class=\"event-notes\">One of the world's longest lava tubes — a UNESCO World Heritage site. Walk through a cathedral-like underground tunnel carved by ancient lava flows. The 7.4km tube has a 1km section open to visitors. <strong>Check reopening status before visiting</strong> — periodic closures for maintenance.\n      <ul>\n        <li>Temperature inside: ~11°C year-round — bring a light jacket</li>\n        <li>Wear non-slip shoes</li>\n        <li>Entry: ~₩4,000</li>\n      </ul>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Manjanggul+Cave+Jeju\" target=\"_blank\" class=\"maps-link\">📍 Manjanggul</a>\n      <a href=\"https://map.naver.com/p/search/만장굴\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Lunch — On the Drive Back</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-08-02T11:00\" data-lat=\"33.54253160461269\" data-lng=\"126.6712426355821\">\n  <div class=\"event-time\">11:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍱 Snack</span></div>\n    <div class=\"event-name\">Haenyeogimbap — Gimbap by the Sea</div>\n    <div class=\"event-notes\">On the drive west from Manjanggul — stop here first while still on the north coast. Fresh haenyeo-style gimbap using locally-caught sea ingredients. A unique Jeju version of the classic Korean rice roll.</div>\n    <div class=\"event-links\">\n      <a href=\"https://share.google/Z42EE57KdOj3QE1oQ\" target=\"_blank\" class=\"maps-link\">📍 Google Maps</a>\n      <a href=\"https://map.naver.com/p/search/해녀의부엌+제주\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-08-02T12:00\" data-lat=\"33.534361533250895\" data-lng=\"126.635465740889\">\n  <div class=\"event-time\">12:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍜 Lunch</span></div>\n    <div class=\"event-name\">통일가든 — Cold Black Bean Noodles</div>\n    <div class=\"event-notes\">Continue west from Haenyeogimbap — a short drive away. Cold black bean noodles (물냉면/짜장) — refreshing and hearty before the afternoon nature loop.</div>\n    <div class=\"event-links\">\n      <a href=\"https://maps.app.goo.gl/gpRGRfnsbDUNPkGi7\" target=\"_blank\" class=\"maps-link\">📍 Google Maps</a>\n      <a href=\"https://map.naver.com/p/search/통일가든+제주\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Afternoon — Nature Loop</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-08-02T14:00\" data-lat=\"33.449446919743444\" data-lng=\"126.65897809190028\">\n  <div class=\"event-time\">14:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🗿 Nature</span></div>\n    <div class=\"event-name\">Jeju Stone Park (돌문화공원)</div>\n    <div class=\"event-notes\">Vast outdoor park celebrating Jeju's volcanic stone culture and mythology. Features hundreds of stone statues (dol hareubang), lava rock formations, and traditional thatched homes set across a sweeping landscape.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Jeju+Stone+Park\" target=\"_blank\" class=\"maps-link\">📍 Jeju Stone Park</a>\n      <a href=\"https://map.naver.com/p/search/제주돌문화공원\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-08-02T15:00\" data-lat=\"33.44753499655823\" data-lng=\"126.667351143356\">\n  <div class=\"event-time\">15:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🌳 Park</span></div>\n    <div class=\"event-name\">Eco Land Theme Park</div>\n    <div class=\"event-notes\">Right next to Stone Park. Scenic park with a vintage train ride through forests and past wetlands. Good for a relaxed afternoon ride through Jeju's countryside.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Eco+Land+Theme+Park+Jeju\" target=\"_blank\" class=\"maps-link\">📍 Eco Land</a>\n      <a href=\"https://map.naver.com/p/search/에코랜드+제주\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-08-02T16:30\" data-lat=\"33.433231454404556\" data-lng=\"126.6905560760605\">\n  <div class=\"event-time\">16:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🌿 Nature</span></div>\n    <div class=\"event-name\">Sangumburi Crater</div>\n    <div class=\"event-notes\">A perfectly circular volcanic crater filled with 420+ plant species. Stunning panoramic walk around the rim. Entry: ~₩3,000. About 30 min loop walk.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Sangumburi+Crater+Jeju\" target=\"_blank\" class=\"maps-link\">📍 Sangumburi</a>\n      <a href=\"https://map.naver.com/p/search/산굼부리\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Evening</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-08-02T17:30\" data-lat=\"33.28189285940979\" data-lng=\"126.6298635374323\">\n  <div class=\"event-time\">17:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍊 Cafe</span></div>\n    <div class=\"event-name\">Gyulbate — Tangerine Cafe</div>\n    <div class=\"event-notes\">Heading south toward dinner — stop here on the way. Jeju tangerine (귤) focused cafe. Try the fresh squeezed tangerine juice or tangerine latte — made from Jeju hallabong, the island's signature citrus.</div>\n    <div class=\"event-links\">\n      <a href=\"https://share.google/T7L5NKhJmMnZzilgk\" target=\"_blank\" class=\"maps-link\">📍 Google Maps</a>\n      <a href=\"https://map.naver.com/p/search/귤밭카페+제주\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Dinner</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-08-02T19:30\" data-lat=\"33.250986428818536\" data-lng=\"126.56288133558213\">\n  <div class=\"event-time\">19:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag tbd\">FREE NIGHT</span><span class=\"tag meal\">🍽️ Dinner</span></div>\n    <div class=\"event-name\">Dinner — South Jeju</div>\n    <div class=\"event-notes\">Find something in the south Jeju area — seafood, galchi (hairtail fish), or local Jeju cuisine recommended since we already had pork BBQ on Jul 31.<br><br>\n      <strong>🔀 Option:</strong> <a href=\"https://share.google/3W40DafHqtsxpKfAx\" target=\"_blank\">Ppolsaljip</a> — Korean BBQ nearby if the group is craving it.\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=restaurants+south+Jeju+Seogwipo\" target=\"_blank\" class=\"maps-link\">📍 Find Dinner</a>\n      <a href=\"https://map.naver.com/p/search/서귀포+저녁+맛집\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"note-box\"><strong>Cave tip:</strong> Bring a light jacket — Manjanggul is 11°C inside regardless of outside temperature. Wear closed-toe shoes for the cave floor. <strong>Weekend breakfast: 07:00–10:00.</strong></div>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":true,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","css":["../styles.css"],"toc":false,"include-in-header":[{"text":"<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" crossorigin=\"\"/>\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\" crossorigin=\"\"></script>\n"}],"include-after-body":["../kst-clock.html"],"output-file":"aug-02.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"Other Links","code-links-title":"Code Links","launc