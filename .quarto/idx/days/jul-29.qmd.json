otori+Garden+Anguk+Seoul' },\n    { name:'Cheonggyecheon Stream 🌊', lat:37.569216302217335, lng:126.97859946256767, c:'#1976D2', url:'https://www.google.com/maps/search/?api=1&query=Cheonggyecheon+Stream+Seoul' },\n    { name:'Sancheong Charcoal Garden (Euljiro) 🔥', lat:37.56596031997875, lng:126.99059447777543, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=Sancheong+Charcoal+Garden+Euljiro+Seoul' },\n    { name:'Heukujeong Japanese Wagyu House 🥩 (24hrs)', lat:37.52427216153643, lng:127.0410749067464, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=Heukujeong+Wagyu+Seoul' },\n    { name:'계탄집 본점 🐔 (Chicken BBQ)', lat:37.53672508312762, lng:127.06693892382688, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=계탄집+본점+서울' },\n    { name:'Yeouido Hangang Park 🚲', lat:37.52690204577482, lng:126.93474875078992, c:'#5C6BC0', url:'https://www.google.com/maps/search/?api=1&query=Yeouido+Hangang+Park+Seoul' },\n  ];\n  function routeLabel(n, color) {\n    return L.divIcon({ className:'', html:'<div style=\"width:18px;height:18px;border-radius:50%;background:'+color+';border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;line-height:1\">'+n+'</div>', iconSize:[18,18], iconAnchor:[9,9] });\n  }\n  // Route 1: Shilla Stay → Studio KJD\n  L.polyline([[37.5572,126.9680],[37.581026686537676,126.9814474067464]], { color:'#4A148C', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5691,126.9747], { icon:routeLabel(1,'#4A148C') }).addTo(map);\n  // Route 2: Studio KJD → Gyeongbokgung Palace\n  L.polyline([[37.581026686537676,126.9814474067464],[37.5796,126.9770]], { color:'#1565C0', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5803,126.9792], { icon:routeLabel(2,'#1565C0') }).addTo(map);\n  // Route 3: Gyeongbokgung → Bukchon Hanok Village\n  L.polyline([[37.5796,126.9770],[37.5823,126.9853]], { color:'#00897B', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5810,126.9812], { icon:routeLabel(3,'#00897B') }).addTo(map);\n  // Route 4: Bukchon → Jalpajin Buckwheat (Seochon, lunch)\n  L.polyline([[37.5823,126.9853],[37.57981030723623,126.97092794907492]], { color:'#F57F17', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5811,126.9781], { icon:routeLabel(4,'#F57F17') }).addTo(map);\n  // Route 5: Jalpajin → Dotori Garden Anguk (still north, near Anguk)\n  L.polyline([[37.57981030723623,126.97092794907492],[37.578232705406045,126.98631787976082]], { color:'#E65100', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5790,126.9786], { icon:routeLabel(5,'#E65100') }).addTo(map);\n  // Route 6: Dotori Garden → Jayeondo Salt Bread (steps away)\n  L.polyline([[37.578232705406045,126.98631787976082],[37.5738239984639,126.98963669140343]], { color:'#AB47BC', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5760,126.9880], { icon:routeLabel(6,'#AB47BC') }).addTo(map);\n  // Route 7: Jayeondo → Yeouido Hangang Park (bikes before 5pm)\n  L.polyline([[37.5738239984639,126.98963669140343],[37.52690204577482,126.93474875078992]], { color:'#5C6BC0', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5504,126.9622], { icon:routeLabel(7,'#5C6BC0') }).addTo(map);\n  // Route 8: Yeouido → Sancheong Charcoal Garden (dinner)\n  L.polyline([[37.52690204577482,126.93474875078992],[37.56596031997875,126.99059447777543]], { color:'#C62828', weight:3, dashArray:'6,5', opacity:0.7 }).addTo(map);\n  L.marker([37.5465,126.9627], { icon:routeLabel(8,'#C62828') }).addTo(map);\n  window.pageMap = map; window.pageMarkers = [];\n  pts.forEach(function(p) {\n    var m = L.marker([p.lat, p.lng], { icon: p.hotel ? hotelDot() : dot(p.c) }).addTo(map);\n    var html = '<b>' + p.name + '</b>';\n    if (p.url) html += '<br><a href=\"' + p.url + '\" target=\"_blank\" style=\"font-size:12px\">Open in Maps →</a>';\n    m.bindPopup(html);\n    window.pageMarkers.push({ marker: m, lat: p.lat, lng: p.lng });\n  });\n})();\n</script>\n```\n\n```{=html}\n<div class=\"section-header\">Morning — Hanbok & Palace</div>\n\n<div class=\"event-card meal\" style=\"border-color:#F9A825;background:#FFFDE7\" data-dt=\"2026-07-29T07:30\" data-lat=\"37.5572\" data-lng=\"126.9680\">\n  <div class=\"event-time\">07:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🍳 Breakfast</span></div>\n    <div class=\"event-name\">Breakfast Buffet · CAFE (B1F) · Shilla Stay</div>\n    <div class=\"event-notes\">Wednesday (Weekday) hours: <strong>06:30–09:30</strong> · ₩23,000/adult · Arrive by <strong>09:00</strong> — strict closing. Early start today for 09:00 hanbok booking.</div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-29T09:00\" data-lat=\"37.581026686537676\" data-lng=\"126.9814474067464\">\n  <div class=\"event-time\">09:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag booked\">BOOKED ✓</span><span class=\"tag activity\">👘 Experience</span></div>\n    <div class=\"event-name\">Studio KJD — Hanbok Rental (2.5 hrs)</div>\n    <div class=\"event-notes\">Traditional Korean hanbok dress-up + photo experience. 2.5 hours included — walk directly to Gyeongbokgung in hanbok for the full experience.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Studio+KJD+Hanbok+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Studio KJD</a>\n      <a href=\"https://map.naver.com/p/search/스튜디오KJD+한복\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-29T09:30\" data-lat=\"37.5796\" data-lng=\"126.9770\">\n  <div class=\"event-time\">09:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🏯 Sightseeing</span></div>\n    <div class=\"event-name\">Gyeongbokgung Palace</div>\n    <div class=\"event-notes\">Korea's main royal palace. Free entry in hanbok! Changing of the guard ceremony at 10:00 and 14:00. One of Seoul's most photogenic spots.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gyeongbokgung+Palace+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gyeongbokgung</a>\n      <a href=\"https://map.naver.com/p/search/경복궁\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-29T11:00\" data-lat=\"37.5823\" data-lng=\"126.9853\">\n  <div class=\"event-time\">11:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🏘️ Village</span></div>\n    <div class=\"event-name\">Bukchon Hanok Village</div>\n    <div class=\"event-notes\">Preserved traditional Korean houses on a hillside. Best explored in hanbok in the morning before crowds arrive. Instagram-famous alleyway on Gahoe-ro 11-gil.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Bukchon+Hanok+Village+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Bukchon</a>\n      <a href=\"https://map.naver.com/p/search/북촌한옥마을\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Lunch — Seochon</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-29T12:00\" data-lat=\"37.57981030723623\" data-lng=\"126.97092794907492\">\n  <div class=\"event-time\">12:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍜 Lunch</span></div>\n    <div class=\"event-name\">Jalpajin Buckwheat Seochon Main</div>\n    <div class=\"event-notes\">Artisan buckwheat noodle restaurant in the charming Seochon (West Village) neighbourhood near the palace.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Jalpajin+Buckwheat+Seochon+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Jalpajin</a>\n      <a href=\"https://map.naver.com/p/search/잘빠진메밀+서촌\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Afternoon — Explore</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T13:30\" data-lat=\"37.578232705406045\" data-lng=\"126.98631787976082\">\n  <div class=\"event-time\">13:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍮 Dessert</span></div>\n    <div class=\"event-name\">Dotori Garden Anguk — Persimmon Dessert</div>\n    <div class=\"event-notes\">Specialty dessert cafe near Anguk station serving beautiful persimmon-based sweets. A unique Korean dessert experience. Close to Bukchon — easy walk after lunch.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Dotori+Garden+Anguk+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Dotori Garden</a>\n      <a href=\"https://map.naver.com/p/search/도토리가든+안국\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T14:00\" data-lat=\"37.5738239984639\" data-lng=\"126.98963669140343\">\n  <div class=\"event-time\">14:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍞 Snack</span></div>\n    <div class=\"event-name\">Jayeondo Salt Bread (소금빵)</div>\n    <div class=\"event-notes\">Crispy, buttery Korean-style salt bread — a must-try street snack. Steps from Dotori Garden. Quick stop before heading to Yeouido.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Jayeondo+Sogeumppang+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Salt Bread Shop</a>\n      <a href=\"https://map.naver.com/p/search/자연도소금빵\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T14:30\" data-lat=\"37.52690204577482\" data-lng=\"126.93474875078992\">\n  <div class=\"event-time\">14:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🚲 Bikes</span></div>\n    <div class=\"event-name\">Yeouido Hangang Park — Bike Rental</div>\n    <div class=\"event-notes\">Rent bikes at Yeouido Hangang Park and cruise the Han River path. <strong>⚠️ Bike rental closes at 5:00 PM — must return by then.</strong> Grab snacks from a nearby convenience store to enjoy riverside while you ride.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Yeouido+Hangang+Park+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Yeouido Hangang Park</a>\n      <a href=\"https://map.naver.com/p/search/여의도한강공원\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n```\n\n```{=html}\n<div class=\"section-header\">Dinner</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-29T19:00\" data-lat=\"37.56596031997875\" data-lng=\"126.99059447777543\">\n  <div class=\"event-time\">Option 1</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🔥 Dinner</span></div>\n    <div class=\"event-name\">Sancheong Charcoal Garden Euljiro — Korean BBQ</div>\n    <div class=\"event-notes\">Premium charcoal-grilled Korean BBQ in the trendy Euljiro area. Order pork belly, marinated ribs, and mix with the banchan spread.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Sancheong+Charcoal+Garden+Euljiro+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Sancheong BBQ</a>\n      <a href=\"https://map.naver.com/p/search/산청숯불가든+을지로\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-29T19:00\" data-lat=\"37.52427216153643\" data-lng=\"127.0410749067464\">\n  <div class=\"event-time\">Option 2</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🥩 Dinner</span></div>\n    <div class=\"event-name\">Heukujeong Japanese Wagyu House (24 Hours)</div>\n    <div class=\"event-notes\">Japanese-style A5 wagyu beef. Open 24 hours — great for a late night splurge.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Heukujeong+Wagyu+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Heukujeong</a>\n      <a href=\"https://map.naver.com/p/search/흑우정+서울\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-29T19:00\" data-lat=\"37.53672508312762\" data-lng=\"127.06693892382688\">\n  <div class=\"event-time\">Option 3</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🐔 Dinner</span></div>\n    <div class=\"event-name\">계탄집 본점 — Chicken BBQ</div>\n    <div class=\"event-notes\">Charcoal-grilled chicken BBQ at the original flagship location.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=계탄집+본점+서울\" target=\"_blank\" class=\"maps-link\">📍 계탄집 본점</a>\n      <a href=\"https://map.naver.com/p/search/계탄집+본점\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Evening (Optional)</div>\n\n<div class=\"event-card evening\" data-dt=\"2026-07-29T21:00\" data-lat=\"37.569216302217335\" data-lng=\"126.97859946256767\">\n  <div class=\"event-time\">21:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag tbd\">Optional</span><span class=\"tag activity\">🌊 Scenic</span></div>\n    <div class=\"event-name\">Cheonggyecheon Stream</div>\n    <div class=\"event-notes\">A peaceful walk along the lit-up stream after dinner. The lanterns and lights reflect beautifully on the water at night.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Cheonggyecheon+Stream+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Cheonggyecheon</a>\n      <a href=\"https://map.naver.com/p/search/청계천\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"note-box\"><strong>Breakfast included</strong> at hotel. · <strong>Hanbok tip:</strong> Free palace entry in hanbok — keep rental receipt.</div>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":true,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pan