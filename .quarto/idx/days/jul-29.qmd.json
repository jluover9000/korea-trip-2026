rest' },\n    { name:'Sancheong Charcoal Garden (Euljiro) 🔥', lat:37.5659, lng:126.9918, c:'#C62828', url:'https://www.google.com/maps/search/?api=1&query=Sancheong+Charcoal+Garden+Euljiro+Seoul' },\n    { name:'Han River 🌙', lat:37.5285, lng:126.9299, c:'#5C6BC0', url:'https://www.google.com/maps/search/?api=1&query=Han+River+Seoul' },\n  ];\n  window.pageMap = map; window.pageMarkers = [];\n  pts.forEach(function(p) {\n    var m = L.marker([p.lat, p.lng], { icon: p.hotel ? hotelDot() : dot(p.c) }).addTo(map);\n    var html = '<b>' + p.name + '</b>';\n    if (p.url) html += '<br><a href=\"' + p.url + '\" target=\"_blank\" style=\"font-size:12px\">Open in Maps →</a>';\n    m.bindPopup(html);\n    window.pageMarkers.push({ marker: m, lat: p.lat, lng: p.lng });\n  });\n})();\n</script>\n```\n\n```{=html}\n<div class=\"section-header\">Morning — Hanbok & Palace</div>\n\n<div class=\"event-card meal\" style=\"border-color:#F9A825;background:#FFFDE7\" data-dt=\"2026-07-29T07:30\" data-lat=\"37.5572\" data-lng=\"126.9680\">\n  <div class=\"event-time\">07:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag note\">🍳 Breakfast</span></div>\n    <div class=\"event-name\">Breakfast Buffet · CAFE (B1F) · Shilla Stay</div>\n    <div class=\"event-notes\">Wednesday (Weekday) hours: <strong>06:30–09:30</strong> · ₩23,000/adult · Arrive by <strong>09:00</strong> — strict closing. Early start today for 09:00 hanbok booking.</div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-29T09:00\" data-lat=\"37.5785\" data-lng=\"126.9735\">\n  <div class=\"event-time\">09:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag booked\">BOOKED ✓</span><span class=\"tag activity\">👘 Experience</span></div>\n    <div class=\"event-name\">Studio KJD — Hanbok Rental (2.5 hrs)</div>\n    <div class=\"event-notes\">Traditional Korean hanbok dress-up + photo experience. 2.5 hours included — walk directly to Gyeongbokgung in hanbok for the full experience.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Studio+KJD+Hanbok+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Studio KJD</a>\n      <a href=\"https://map.naver.com/p/search/스튜디오KJD+한복\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-29T09:30\" data-lat=\"37.5796\" data-lng=\"126.9770\">\n  <div class=\"event-time\">09:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🏯 Sightseeing</span></div>\n    <div class=\"event-name\">Gyeongbokgung Palace</div>\n    <div class=\"event-notes\">Korea's main royal palace. Free entry in hanbok! Changing of the guard ceremony at 10:00 and 14:00. One of Seoul's most photogenic spots.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gyeongbokgung+Palace+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gyeongbokgung</a>\n      <a href=\"https://map.naver.com/p/search/경복궁\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card morning\" data-dt=\"2026-07-29T11:00\" data-lat=\"37.5823\" data-lng=\"126.9853\">\n  <div class=\"event-time\">11:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🏘️ Village</span></div>\n    <div class=\"event-name\">Bukchon Hanok Village</div>\n    <div class=\"event-notes\">Preserved traditional Korean houses on a hillside. Best explored in hanbok in the morning before crowds arrive. Instagram-famous alleyway on Gahoe-ro 11-gil.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Bukchon+Hanok+Village+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Bukchon</a>\n      <a href=\"https://map.naver.com/p/search/북촌한옥마을\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Lunch — Seochon</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-29T12:00\" data-lat=\"37.5788\" data-lng=\"126.9689\">\n  <div class=\"event-time\">12:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍜 Lunch</span></div>\n    <div class=\"event-name\">Jalpajin Buckwheat Seochon Main</div>\n    <div class=\"event-notes\">Artisan buckwheat noodle restaurant in the charming Seochon (West Village) neighbourhood near the palace.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Jalpajin+Buckwheat+Seochon+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Jalpajin</a>\n      <a href=\"https://map.naver.com/p/search/잘빠진메밀+서촌\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Afternoon — Explore</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T13:30\" data-lat=\"37.5810\" data-lng=\"126.9700\">\n  <div class=\"event-time\">13:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍞 Snack</span></div>\n    <div class=\"event-name\">Jayeondo Salt Bread (소금빵)</div>\n    <div class=\"event-notes\">Crispy, buttery Korean-style salt bread — a must-try street snack. Jayeondo Sogeumppang & Jayeondoga has legendary versions near the palace area.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Jayeondo+Sogeumppang+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Salt Bread Shop</a>\n      <a href=\"https://map.naver.com/p/search/자연도소금빵\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T14:30\" data-lat=\"37.5446\" data-lng=\"127.0378\">\n  <div class=\"event-time\">14:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🌳 Park</span></div>\n    <div class=\"event-name\">Seoul Forest</div>\n    <div class=\"event-notes\">Large urban park — good for a stroll. Deer enclosure, butterfly garden, and nice paths along the Han River tributary.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Seoul+Forest\" target=\"_blank\" class=\"maps-link\">📍 Seoul Forest</a>\n      <a href=\"https://map.naver.com/p/search/서울숲\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T15:30\" data-lat=\"37.5694\" data-lng=\"126.9830\">\n  <div class=\"event-time\">15:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🌊 Scenic</span></div>\n    <div class=\"event-name\">Cheonggyecheon Stream</div>\n    <div class=\"event-notes\">Elevated highway that was turned into a beautiful urban stream. Walk along the banks through the heart of the city — a great evening stroll.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Cheonggyecheon+Stream+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Cheonggyecheon</a>\n      <a href=\"https://map.naver.com/p/search/청계천\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card afternoon\" data-dt=\"2026-07-29T16:30\" data-lat=\"37.5800\" data-lng=\"126.9823\">\n  <div class=\"event-time\">16:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍮 Dessert</span></div>\n    <div class=\"event-name\">Dotori Garden Anguk — Persimmon Dessert</div>\n    <div class=\"event-notes\">Specialty dessert cafe near Anguk station serving beautiful persimmon-based sweets. A unique Korean dessert experience.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Dotori+Garden+Anguk+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Dotori Garden</a>\n      <a href=\"https://map.naver.com/p/search/도토리가든+안국\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Dinner</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-29T19:00\" data-lat=\"37.5659\" data-lng=\"126.9918\">\n  <div class=\"event-time\">19:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🔥 Dinner</span></div>\n    <div class=\"event-name\">Sancheong Charcoal Garden Euljiro — Korean BBQ</div>\n    <div class=\"event-notes\">Premium charcoal-grilled Korean BBQ in the trendy Euljiro area. Order pork belly, marinated ribs, and mix with the banchan spread.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Sancheong+Charcoal+Garden+Euljiro+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Sancheong BBQ</a>\n      <a href=\"https://map.naver.com/p/search/산청숯불가든+을지로\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Evening</div>\n\n<div class=\"event-card evening\" data-dt=\"2026-07-29T21:00\" data-lat=\"37.5285\" data-lng=\"126.9299\">\n  <div class=\"event-time\">21:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🌙 Evening</span></div>\n    <div class=\"event-name\">Han River — Noodles & Tteok</div>\n    <div class=\"event-notes\">Evening picnic vibes at the Han River. Grab instant noodles and tteok (rice cakes) from a nearby convenience store. Yeouido Hangang Park is a popular spot.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Yeouido+Hangang+Park+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Han River Park</a>\n      <a href=\"https://map.naver.com/p/search/여의도한강공원\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"note-box\"><strong>Breakfast included</strong> at hotel. · <strong>Hanbok tip:</strong> Free palace entry in hanbok — keep rental receipt.</div>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":true,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","css":["../styles.css"],"toc":false,"include-in-header":[{"text":"<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" crossorigin=\"\"/>\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\" crossorigin=\"\"></script>\n"}],"include-after-body":["../kst-clock.h