{"title":"Jul 27 — Arrive Seoul","markdown":{"yaml":{"title":"Jul 27 — Arrive Seoul"},"containsRefs":false,"markdown":"\n\n```{=html}\n<div class=\"day-hero\">\n  <div class=\"day-badge\">Monday · July 27, 2026 · Day 2 of 15</div>\n  <h1 class=\"day-title\">Arrive Seoul 🛬</h1>\n  <div class=\"day-subtitle\">📍 Incheon Airport → Myeongdong · <strong>Hotel:</strong> Shilla Stay Seodaemun Seoul Station</div>\n  <div class=\"finalized-badge\">✅ Finalized</div>\n</div>\n```\n\n```{=html}\n<div id=\"map-jul27\" class=\"day-map\"></div>\n<script>\n(function() {\n  var map = L.map('map-jul27').setView([37.5580, 126.9730], 13);\n  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n    attribution: '© <a href=\"https://www.openstreetmap.org/copyright\">OSM</a>'\n  }).addTo(map);\n  function dot(c) {\n    return L.divIcon({ className:'', html:'<div style=\"width:13px;height:13px;border-radius:50%;background:'+c+';border:2.5px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.4)\"></div>', iconSize:[13,13], iconAnchor:[6,6], popupAnchor:[0,-8] });\n  }\n  function hotelDot() {\n    return L.divIcon({ className:'', html:'<div style=\"width:22px;height:22px;border-radius:50%;background:#4A148C;border:2.5px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;font-size:12px;line-height:1;color:#fff\">★</div>', iconSize:[22,22], iconAnchor:[11,11], popupAnchor:[0,-13] });\n  }\n  var pts = [\n    { name:'Shilla Stay Seodaemun Seoul Station 🏨', lat:37.5572, lng:126.9680, hotel:true, url:'https://www.google.com/maps/search/?api=1&query=Shilla+Stay+Seodaemun+Seoul+Station' },\n    { name:'Myeongdong 🛒', lat:37.5636, lng:126.9834, c:'#E53935', url:'https://www.google.com/maps/search/?api=1&query=Myeongdong+Seoul' },\n    { name:'Gwangjang Market 🥟', lat:37.5698, lng:126.9993, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Gwangjang+Market+Seoul' },\n    { name:'Gamekol Son Wangmandu 🥟', lat:37.5700, lng:126.9985, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Gamekol+Son+Wangmandu+Seoul' },\n  ];\n  L.polyline([[37.5572, 126.9680], [37.5698, 126.9993]], { color:'#7B1FA2', weight:3, opacity:0.8 }).addTo(map);\n  L.marker([(37.5572+37.5698)/2, (126.9680+126.9993)/2], {\n    icon: L.divIcon({ className:'', html:'<div style=\"background:#7B1FA2;color:#fff;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)\">1</div>', iconSize:[20,20], iconAnchor:[10,10] })\n  }).addTo(map).bindPopup('<b>① Shilla Stay → Gwangjang Market</b><br>Line 5 · ~11 min');\n  L.polyline([[37.5698, 126.9993], [37.5636, 126.9834]], { color:'#E65100', weight:3, opacity:0.8 }).addTo(map);\n  L.marker([(37.5698+37.5636)/2, (126.9993+126.9834)/2], {\n    icon: L.divIcon({ className:'', html:'<div style=\"background:#E65100;color:#fff;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)\">2</div>', iconSize:[20,20], iconAnchor:[10,10] })\n  }).addTo(map).bindPopup('<b>② Gwangjang Market → Myeongdong</b><br>Bus 104 · ~13 min');\n\n  window.pageMap = map; window.pageMarkers = [];\n  pts.forEach(function(p) {\n    var m = L.marker([p.lat, p.lng], { icon: p.hotel ? hotelDot() : dot(p.c) }).addTo(map);\n    var html = '<b>' + p.name + '</b>';\n    if (p.url) html += '<br><a href=\"' + p.url + '\" target=\"_blank\" style=\"font-size:12px\">Open in Maps →</a>';\n    m.bindPopup(html);\n    window.pageMarkers.push({ marker: m, lat: p.lat, lng: p.lng });\n  });\n})();\n</script>\n```\n\n```{=html}\n<div class=\"section-header\">Afternoon — Arrival</div>\n\n<div class=\"event-card transport\" data-dt=\"2026-07-27T16:05\">\n  <div class=\"event-time\">16:05</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">✈️ Arrival</span></div>\n    <div class=\"event-name\">Arrive Incheon International Airport (ICN)</div>\n    <div class=\"event-notes\">Clear immigration, collect luggage, then head straight to the SIM card pick-up before exiting. Take <strong>Airport Limousine Bus</strong>.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Incheon+International+Airport\" target=\"_blank\" class=\"maps-link\">📍 ICN Airport</a>\n      <a href=\"https://map.naver.com/p/search/인천국제공항\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card activity\" data-dt=\"2026-07-27T16:20\">\n  <div class=\"event-time\">16:20</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag booked\">BOOKED ✓ Klook</span><span class=\"tag transport\">📱 SIM Card</span></div>\n    <div class=\"event-name\">Pick Up LG U+ SIM Cards (×2) — Includes Free T-Money Card</div>\n    <div class=\"event-notes\">\n      <strong>2 physical SIM cards</strong> pre-booked on Klook · LG U+ network\n      <ul>\n        <li>Validity: <strong>15 days</strong></li>\n        <li>Data: <strong>Unlimited</strong></li>\n        <li>Calls &amp; texts included (with extra top-up option)</li>\n        <li>Each SIM comes with a <strong>free T-Money card</strong> — no need to buy one separately</li>\n      </ul>\n      <strong>Pick-up locations at T1 Arrivals (1F):</strong>\n      <ul>\n        <li>⭐ <strong>Gate A</strong> — 06:00–22:00 · <em>Recommended for faster service</em></li>\n        <li>Gate F — 00:00–23:59 (24hr, use if arriving very late)</li>\n      </ul>\n      Head to Gate A counter first — shorter wait times.\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Incheon+Airport+Terminal+1+Arrivals+Gate+A\" target=\"_blank\" class=\"maps-link\">📍 Gate A, T1 Arrivals</a>\n      <a href=\"https://map.naver.com/p/search/인천공항+1터미널+게이트A\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card transport\" data-dt=\"2026-07-27T16:45\">\n  <div class=\"event-time\">16:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚌 Limousine Bus</span></div>\n    <div class=\"event-name\">Airport Limousine Bus → Shilla Stay Seodaemun</div>\n    <div class=\"event-notes\">\n      Buy tickets at the kiosks or staffed counters inside T1 Arrivals, then head outside to <strong>T1, 1F, Stop No. 5</strong>. Two routes both go directly to the hotel:\n      <table style=\"width:100%;border-collapse:collapse;margin-top:8px;font-size:12.5px\">\n        <thead>\n          <tr style=\"background:#f5f5f5\">\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Route</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Fare</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Frequency</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Hours</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Time</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\"><strong>#6002</strong> ⭐</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\"><strong>₩10,000</strong></td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">Every 15 min</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">05:30–23:30</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">~67 min</td>\n          </tr>\n          <tr style=\"background:#fafafa\">\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\"><strong>#6005</strong></td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">₩15,000</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">Every 30 min</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">06:35–23:00</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">~70 min</td>\n          </tr>\n        </tbody>\n      </table>\n      <div style=\"margin-top:8px\">Drop-off: <strong>Seodaemun Station Sageori</strong> — right at the hotel entrance. Both routes use the same stop.</div>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Incheon+Airport+Terminal+1+bus+stop+5+arrivals\" target=\"_blank\" class=\"maps-link\">📍 T1 Stop No. 5</a>\n      <a href=\"https://map.naver.com/p/search/인천공항+리무진버스+5번\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n      <a href=\"https://airportlimousine.co.kr/en/sub/sub01.php?cat_no=13\" target=\"_blank\" class=\"maps-link\">🌐 Route Info</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card activity\" data-dt=\"2026-07-27T17:30\" data-lat=\"37.5572\" data-lng=\"126.9680\">\n  <div class=\"event-time\">17:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🏨 Check-in</span></div>\n    <div class=\"event-name\">Check In · Shilla Stay Seodaemun Seoul Station</div>\n    <div class=\"event-notes\">Home base for the first Seoul leg (Jul 27–30). Near Seoul Station for easy city access. The #6002/#6005 bus stops nearby — confirm the drop-off point with the driver.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Shilla+Stay+Seodaemun+Seoul+Station\" target=\"_blank\" class=\"maps-link\">📍 Hotel Map</a>\n      <a href=\"https://map.naver.com/p/search/쉐라톤스테이서울역\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n\n<div class=\"event-card transport\" data-dt=\"2026-07-27T18:00\">\n  <div class=\"event-time\">18:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚇 Subway</span></div>\n    <div class=\"event-name\">Shilla Stay → Gwangjang Market by Subway</div>\n    <div class=\"event-notes\">\n      <ol style=\"margin:0;padding-left:18px\">\n        <li>Board at <strong>Seodaemun Station</strong> on <strong>Line 5</strong> <span style=\"display:inline-block;background:#996CAC;color:#fff;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:700\">Purple</span> — direction <strong>Gwanghwamun</strong></li>\n        <li>Ride 4 stops and get off at <strong>Euljiro 4-ga Station</strong></li>\n        <li>Walk <strong>~4 minutes</strong> to Gwangjang Market</li>\n      </ol>\n      <div style=\"margin-top:8px;font-size:12.5px;color:#555\">Total trip time: <strong>~11 minutes</strong></div>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Seodaemun+Station+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Seodaemun Station</a>\n      <a href=\"https://map.naver.com/p/search/서대문역\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n```\n\n```{=html}\n<div class=\"section-header\">Dinner — Choose One</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T18:30\" data-lat=\"37.5698\" data-lng=\"126.9993\">\n  <div class=\"event-time\">18:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🥟 Option A</span></div>\n    <div class=\"event-name\">Gwangjang Market</div>\n    <div class=\"event-notes\">Seoul's oldest market. Famous for: <ul><li>Bindaetteok (mung bean pancakes)</li><li>Mayak gimbap (bite-sized rolls)</li><li>Yukhoe (Korean beef tartare)</li></ul>Great atmosphere day and night.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gwangjang+Market+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gwangjang Market</a>\n      <a href=\"https://map.naver.com/p/search/광장시장\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T18:30\" data-lat=\"37.5700\" data-lng=\"126.9985\">\n  <div class=\"event-time\">18:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🥟 Option B</span><span class=\"tag note\">⚠️ Closes 19:30</span></div>\n    <div class=\"event-name\">Gamekol Son Wangmandu</div>\n    <div class=\"event-notes\">Hand-made giant dumplings. <strong>Closes at 19:30</strong> — go early or skip to Gwangjang.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gamekol+Son+Wangmandu+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gamekol Map</a>\n      <a href=\"https://map.naver.com/p/search/감이골+손왕만두\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"event-card transport\" data-dt=\"2026-07-27T19:30\">\n  <div class=\"event-time\">19:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚌 Bus</span></div>\n    <div class=\"event-name\">Gwangjang Market → Myeongdong by Bus 104</div>\n    <div class=\"event-notes\">\n      <ol style=\"margin:0;padding-left:18px\">\n        <li>Board <strong>Bus 104</strong> near Gwangjang Market</li>\n        <li>Get off at <strong>Toegye-ro 2-ga</strong> stop</li>\n        <li>Head to <strong>Myeongdong Station Exit 7</strong></li>\n      </ol>\n      <div style=\"margin-top:8px;font-size:12.5px;color:#555\">Total trip time: <strong>~13 minutes</strong></div>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gwangjang+Market+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gwangjang Market</a>\n      <a href=\"https://map.naver.com/p/search/광장시장\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Evening — Myeongdong</div>\n\n<div class=\"event-card evening\" data-dt=\"2026-07-27T19:45\" data-lat=\"37.5636\" data-lng=\"126.9834\">\n  <div class=\"event-time\">19:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🛍️ Shopping</span></div>\n    <div class=\"event-name\">Explore Myeongdong</div>\n    <div class=\"event-notes\">One of Seoul's most iconic shopping & street food districts. Packed with K-beauty, fashion, and snacks.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Myeongdong+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Myeongdong</a>\n      <a href=\"https://map.naver.com/p/search/명동\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card shopping\" data-dt=\"2026-07-27T19:45\" data-lat=\"37.5636\" data-lng=\"126.9834\">\n  <div class=\"event-time\">19:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag shopping\">💄 Beauty</span></div>\n    <div class=\"event-name\">Olive Young Haul</div>\n    <div class=\"event-notes\">Korea's biggest K-beauty chain. Tax-free shopping available with passport. Stock up on sheet masks, sunscreens, toners.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Olive+Young+Myeongdong\" target=\"_blank\" class=\"maps-link\">📍 Olive Young Myeongdong</a>\n      <a href=\"https://map.naver.com/p/search/올리브영+명동\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T19:45\" data-lat=\"37.5636\" data-lng=\"126.9834\">\n  <div class=\"event-time\">19:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍽️ Dinner</span></div>\n    <div class=\"event-name\">NYU NYU Myeongdong</div>\n    <div class=\"event-notes\">Popular snack stop in Myeongdong.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=NYU+NYU+Myeongdong+Seoul\" target=\"_blank\" class=\"maps-link\">📍 NYU NYU</a>\n      <a href=\"https://map.naver.com/p/search/NYU+NYU+명동\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T21:45\"\">\n  <div class=\"event-time\">21:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚌 Bus</span></div>\n    <div class=\"event-name\">Myeongdong to Shilla Stay</div>\n    <div class=\"event-notes\">GPS back home - expect 20mins - Most likely we'd have to bus home - If subway then we'd have to take Line 4 (Blue) then transfer at Gwanghui-dong, take Line 5</div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Late Night (Back by 22:10)</div>\n```\n\n```{=html}\n<div class=\"event-card activity\" style=\"border-color:#5C6BC0;background:#F8F8FF;margin-top:24px\">\n  <div class=\"event-time\">💤</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">😴 Jet Lag Strategy</span></div>\n    <div class=\"event-name\">Arrival Day Sleep Plan — Survive Tonight</div>\n    <div class=\"event-notes\">\n      You land at 16:05 KST but your body clock reads <strong>midnight Vancouver time</strong>. The key is to hold out until a reasonable Korean bedtime without crashing early. One bad nap now can knock your sleep schedule off for days.\n      <div style=\"margin-top:12px;display:flex;flex-direction:column;gap:0\">\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#FFEBEE;border-radius:8px 8px 0 0;border-left:4px solid #C62828\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#B71C1C\">16:05–18:00 KST<br><span style=\"font-weight:400;color:#C62828\">00:05–02:00 PDT</span></div>\n          <div><strong>⚠️ Do NOT nap</strong> — even lying down \"just for 20 min\" will become 3 hours. Get the SIM, take the bus, check in, and go straight outside. Movement helps.</div>\n        </div>\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#FFF3E0;border-left:4px solid #E65100\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#E65100\">18:00–21:00 KST<br><span style=\"font-weight:400;color:#E65100\">02:00–05:00 PDT</span></div>\n          <div><strong>Stay busy</strong> — Bright lights, food, and walking are your best friend right now. Eat a proper dinner even if you're not hungry.</div>\n        </div>\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#E8F5E9;border-left:4px solid #2E7D32\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#1B5E20\">21:00–22:00 KST<br><span style=\"font-weight:400;color:#2E7D32\">05:00–06:00 PDT</span></div>\n          <div><strong>😴 Bedtime</strong> — this is your target. Take a melatonin (0.5–1mg), shower, black out the room. Don't fight it past 22:00 — earlier is fine.</div>\n        </div>\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#E3F2FD;border-radius:0 0 8px 8px;border-left:4px solid #1565C0\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#0D47A1\">07:00–08:00 KST<br><span style=\"font-weight:400;color:#1565C0\">15:00–16:00 PDT</span></div>\n          <div><strong>Wake up</strong> — set an alarm. Your body clock will likely wake you earlier (Vancouver afternoon = Seoul early morning). Get up, open curtains, get sunlight. Day 2 starts fresh. ☀️</div>\n        </div>\n\n      </div>\n      <div style=\"margin-top:10px;font-size:12px;color:#777\">☀️ <strong>Sunlight is the strongest reset signal</strong> — get outside in the morning on Day 2 (Jul 28). Breakfast on the hotel terrace or a walk before the Gangnam day helps lock in your new rhythm.</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"note-box\"><strong>Breakfast included</strong> at hotel daily. · <strong>T-Money:</strong> comes free with your LG U+ SIM — top it up at any convenience store or subway machine.</div>\n```\n","srcMarkdownNoYaml":"\n\n```{=html}\n<div class=\"day-hero\">\n  <div class=\"day-badge\">Monday · July 27, 2026 · Day 2 of 15</div>\n  <h1 class=\"day-title\">Arrive Seoul 🛬</h1>\n  <div class=\"day-subtitle\">📍 Incheon Airport → Myeongdong · <strong>Hotel:</strong> Shilla Stay Seodaemun Seoul Station</div>\n  <div class=\"finalized-badge\">✅ Finalized</div>\n</div>\n```\n\n```{=html}\n<div id=\"map-jul27\" class=\"day-map\"></div>\n<script>\n(function() {\n  var map = L.map('map-jul27').setView([37.5580, 126.9730], 13);\n  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n    attribution: '© <a href=\"https://www.openstreetmap.org/copyright\">OSM</a>'\n  }).addTo(map);\n  function dot(c) {\n    return L.divIcon({ className:'', html:'<div style=\"width:13px;height:13px;border-radius:50%;background:'+c+';border:2.5px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.4)\"></div>', iconSize:[13,13], iconAnchor:[6,6], popupAnchor:[0,-8] });\n  }\n  function hotelDot() {\n    return L.divIcon({ className:'', html:'<div style=\"width:22px;height:22px;border-radius:50%;background:#4A148C;border:2.5px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;font-size:12px;line-height:1;color:#fff\">★</div>', iconSize:[22,22], iconAnchor:[11,11], popupAnchor:[0,-13] });\n  }\n  var pts = [\n    { name:'Shilla Stay Seodaemun Seoul Station 🏨', lat:37.5572, lng:126.9680, hotel:true, url:'https://www.google.com/maps/search/?api=1&query=Shilla+Stay+Seodaemun+Seoul+Station' },\n    { name:'Myeongdong 🛒', lat:37.5636, lng:126.9834, c:'#E53935', url:'https://www.google.com/maps/search/?api=1&query=Myeongdong+Seoul' },\n    { name:'Gwangjang Market 🥟', lat:37.5698, lng:126.9993, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Gwangjang+Market+Seoul' },\n    { name:'Gamekol Son Wangmandu 🥟', lat:37.5700, lng:126.9985, c:'#43A047', url:'https://www.google.com/maps/search/?api=1&query=Gamekol+Son+Wangmandu+Seoul' },\n  ];\n  L.polyline([[37.5572, 126.9680], [37.5698, 126.9993]], { color:'#7B1FA2', weight:3, opacity:0.8 }).addTo(map);\n  L.marker([(37.5572+37.5698)/2, (126.9680+126.9993)/2], {\n    icon: L.divIcon({ className:'', html:'<div style=\"background:#7B1FA2;color:#fff;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)\">1</div>', iconSize:[20,20], iconAnchor:[10,10] })\n  }).addTo(map).bindPopup('<b>① Shilla Stay → Gwangjang Market</b><br>Line 5 · ~11 min');\n  L.polyline([[37.5698, 126.9993], [37.5636, 126.9834]], { color:'#E65100', weight:3, opacity:0.8 }).addTo(map);\n  L.marker([(37.5698+37.5636)/2, (126.9993+126.9834)/2], {\n    icon: L.divIcon({ className:'', html:'<div style=\"background:#E65100;color:#fff;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)\">2</div>', iconSize:[20,20], iconAnchor:[10,10] })\n  }).addTo(map).bindPopup('<b>② Gwangjang Market → Myeongdong</b><br>Bus 104 · ~13 min');\n\n  window.pageMap = map; window.pageMarkers = [];\n  pts.forEach(function(p) {\n    var m = L.marker([p.lat, p.lng], { icon: p.hotel ? hotelDot() : dot(p.c) }).addTo(map);\n    var html = '<b>' + p.name + '</b>';\n    if (p.url) html += '<br><a href=\"' + p.url + '\" target=\"_blank\" style=\"font-size:12px\">Open in Maps →</a>';\n    m.bindPopup(html);\n    window.pageMarkers.push({ marker: m, lat: p.lat, lng: p.lng });\n  });\n})();\n</script>\n```\n\n```{=html}\n<div class=\"section-header\">Afternoon — Arrival</div>\n\n<div class=\"event-card transport\" data-dt=\"2026-07-27T16:05\">\n  <div class=\"event-time\">16:05</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">✈️ Arrival</span></div>\n    <div class=\"event-name\">Arrive Incheon International Airport (ICN)</div>\n    <div class=\"event-notes\">Clear immigration, collect luggage, then head straight to the SIM card pick-up before exiting. Take <strong>Airport Limousine Bus</strong>.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Incheon+International+Airport\" target=\"_blank\" class=\"maps-link\">📍 ICN Airport</a>\n      <a href=\"https://map.naver.com/p/search/인천국제공항\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card activity\" data-dt=\"2026-07-27T16:20\">\n  <div class=\"event-time\">16:20</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag booked\">BOOKED ✓ Klook</span><span class=\"tag transport\">📱 SIM Card</span></div>\n    <div class=\"event-name\">Pick Up LG U+ SIM Cards (×2) — Includes Free T-Money Card</div>\n    <div class=\"event-notes\">\n      <strong>2 physical SIM cards</strong> pre-booked on Klook · LG U+ network\n      <ul>\n        <li>Validity: <strong>15 days</strong></li>\n        <li>Data: <strong>Unlimited</strong></li>\n        <li>Calls &amp; texts included (with extra top-up option)</li>\n        <li>Each SIM comes with a <strong>free T-Money card</strong> — no need to buy one separately</li>\n      </ul>\n      <strong>Pick-up locations at T1 Arrivals (1F):</strong>\n      <ul>\n        <li>⭐ <strong>Gate A</strong> — 06:00–22:00 · <em>Recommended for faster service</em></li>\n        <li>Gate F — 00:00–23:59 (24hr, use if arriving very late)</li>\n      </ul>\n      Head to Gate A counter first — shorter wait times.\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Incheon+Airport+Terminal+1+Arrivals+Gate+A\" target=\"_blank\" class=\"maps-link\">📍 Gate A, T1 Arrivals</a>\n      <a href=\"https://map.naver.com/p/search/인천공항+1터미널+게이트A\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card transport\" data-dt=\"2026-07-27T16:45\">\n  <div class=\"event-time\">16:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚌 Limousine Bus</span></div>\n    <div class=\"event-name\">Airport Limousine Bus → Shilla Stay Seodaemun</div>\n    <div class=\"event-notes\">\n      Buy tickets at the kiosks or staffed counters inside T1 Arrivals, then head outside to <strong>T1, 1F, Stop No. 5</strong>. Two routes both go directly to the hotel:\n      <table style=\"width:100%;border-collapse:collapse;margin-top:8px;font-size:12.5px\">\n        <thead>\n          <tr style=\"background:#f5f5f5\">\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Route</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Fare</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Frequency</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Hours</th>\n            <th style=\"padding:6px 10px;text-align:left;border:1px solid #e0e0e0\">Time</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\"><strong>#6002</strong> ⭐</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\"><strong>₩10,000</strong></td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">Every 15 min</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">05:30–23:30</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">~67 min</td>\n          </tr>\n          <tr style=\"background:#fafafa\">\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\"><strong>#6005</strong></td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">₩15,000</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">Every 30 min</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">06:35–23:00</td>\n            <td style=\"padding:6px 10px;border:1px solid #e0e0e0\">~70 min</td>\n          </tr>\n        </tbody>\n      </table>\n      <div style=\"margin-top:8px\">Drop-off: <strong>Seodaemun Station Sageori</strong> — right at the hotel entrance. Both routes use the same stop.</div>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Incheon+Airport+Terminal+1+bus+stop+5+arrivals\" target=\"_blank\" class=\"maps-link\">📍 T1 Stop No. 5</a>\n      <a href=\"https://map.naver.com/p/search/인천공항+리무진버스+5번\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n      <a href=\"https://airportlimousine.co.kr/en/sub/sub01.php?cat_no=13\" target=\"_blank\" class=\"maps-link\">🌐 Route Info</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card activity\" data-dt=\"2026-07-27T17:30\" data-lat=\"37.5572\" data-lng=\"126.9680\">\n  <div class=\"event-time\">17:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🏨 Check-in</span></div>\n    <div class=\"event-name\">Check In · Shilla Stay Seodaemun Seoul Station</div>\n    <div class=\"event-notes\">Home base for the first Seoul leg (Jul 27–30). Near Seoul Station for easy city access. The #6002/#6005 bus stops nearby — confirm the drop-off point with the driver.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Shilla+Stay+Seodaemun+Seoul+Station\" target=\"_blank\" class=\"maps-link\">📍 Hotel Map</a>\n      <a href=\"https://map.naver.com/p/search/쉐라톤스테이서울역\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n\n<div class=\"event-card transport\" data-dt=\"2026-07-27T18:00\">\n  <div class=\"event-time\">18:00</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚇 Subway</span></div>\n    <div class=\"event-name\">Shilla Stay → Gwangjang Market by Subway</div>\n    <div class=\"event-notes\">\n      <ol style=\"margin:0;padding-left:18px\">\n        <li>Board at <strong>Seodaemun Station</strong> on <strong>Line 5</strong> <span style=\"display:inline-block;background:#996CAC;color:#fff;border-radius:4px;padding:1px 6px;font-size:11px;font-weight:700\">Purple</span> — direction <strong>Gwanghwamun</strong></li>\n        <li>Ride 4 stops and get off at <strong>Euljiro 4-ga Station</strong></li>\n        <li>Walk <strong>~4 minutes</strong> to Gwangjang Market</li>\n      </ol>\n      <div style=\"margin-top:8px;font-size:12.5px;color:#555\">Total trip time: <strong>~11 minutes</strong></div>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Seodaemun+Station+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Seodaemun Station</a>\n      <a href=\"https://map.naver.com/p/search/서대문역\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n```\n\n```{=html}\n<div class=\"section-header\">Dinner — Choose One</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T18:30\" data-lat=\"37.5698\" data-lng=\"126.9993\">\n  <div class=\"event-time\">18:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🥟 Option A</span></div>\n    <div class=\"event-name\">Gwangjang Market</div>\n    <div class=\"event-notes\">Seoul's oldest market. Famous for: <ul><li>Bindaetteok (mung bean pancakes)</li><li>Mayak gimbap (bite-sized rolls)</li><li>Yukhoe (Korean beef tartare)</li></ul>Great atmosphere day and night.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gwangjang+Market+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gwangjang Market</a>\n      <a href=\"https://map.naver.com/p/search/광장시장\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T18:30\" data-lat=\"37.5700\" data-lng=\"126.9985\">\n  <div class=\"event-time\">18:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🥟 Option B</span><span class=\"tag note\">⚠️ Closes 19:30</span></div>\n    <div class=\"event-name\">Gamekol Son Wangmandu</div>\n    <div class=\"event-notes\">Hand-made giant dumplings. <strong>Closes at 19:30</strong> — go early or skip to Gwangjang.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gamekol+Son+Wangmandu+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gamekol Map</a>\n      <a href=\"https://map.naver.com/p/search/감이골+손왕만두\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"event-card transport\" data-dt=\"2026-07-27T19:30\">\n  <div class=\"event-time\">19:30</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚌 Bus</span></div>\n    <div class=\"event-name\">Gwangjang Market → Myeongdong by Bus 104</div>\n    <div class=\"event-notes\">\n      <ol style=\"margin:0;padding-left:18px\">\n        <li>Board <strong>Bus 104</strong> near Gwangjang Market</li>\n        <li>Get off at <strong>Toegye-ro 2-ga</strong> stop</li>\n        <li>Head to <strong>Myeongdong Station Exit 7</strong></li>\n      </ol>\n      <div style=\"margin-top:8px;font-size:12.5px;color:#555\">Total trip time: <strong>~13 minutes</strong></div>\n    </div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Gwangjang+Market+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Gwangjang Market</a>\n      <a href=\"https://map.naver.com/p/search/광장시장\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Evening — Myeongdong</div>\n\n<div class=\"event-card evening\" data-dt=\"2026-07-27T19:45\" data-lat=\"37.5636\" data-lng=\"126.9834\">\n  <div class=\"event-time\">19:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">🛍️ Shopping</span></div>\n    <div class=\"event-name\">Explore Myeongdong</div>\n    <div class=\"event-notes\">One of Seoul's most iconic shopping & street food districts. Packed with K-beauty, fashion, and snacks.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Myeongdong+Seoul\" target=\"_blank\" class=\"maps-link\">📍 Myeongdong</a>\n      <a href=\"https://map.naver.com/p/search/명동\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card shopping\" data-dt=\"2026-07-27T19:45\" data-lat=\"37.5636\" data-lng=\"126.9834\">\n  <div class=\"event-time\">19:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag shopping\">💄 Beauty</span></div>\n    <div class=\"event-name\">Olive Young Haul</div>\n    <div class=\"event-notes\">Korea's biggest K-beauty chain. Tax-free shopping available with passport. Stock up on sheet masks, sunscreens, toners.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=Olive+Young+Myeongdong\" target=\"_blank\" class=\"maps-link\">📍 Olive Young Myeongdong</a>\n      <a href=\"https://map.naver.com/p/search/올리브영+명동\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T19:45\" data-lat=\"37.5636\" data-lng=\"126.9834\">\n  <div class=\"event-time\">19:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag meal\">🍽️ Dinner</span></div>\n    <div class=\"event-name\">NYU NYU Myeongdong</div>\n    <div class=\"event-notes\">Popular snack stop in Myeongdong.</div>\n    <div class=\"event-links\">\n      <a href=\"https://www.google.com/maps/search/?api=1&query=NYU+NYU+Myeongdong+Seoul\" target=\"_blank\" class=\"maps-link\">📍 NYU NYU</a>\n      <a href=\"https://map.naver.com/p/search/NYU+NYU+명동\" target=\"_blank\" class=\"maps-link naver-link\">🗺 Naver</a>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-card meal\" data-dt=\"2026-07-27T21:45\"\">\n  <div class=\"event-time\">21:45</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag transport\">🚌 Bus</span></div>\n    <div class=\"event-name\">Myeongdong to Shilla Stay</div>\n    <div class=\"event-notes\">GPS back home - expect 20mins - Most likely we'd have to bus home - If subway then we'd have to take Line 4 (Blue) then transfer at Gwanghui-dong, take Line 5</div>\n  </div>\n</div>\n```\n\n```{=html}\n<div class=\"section-header\">Late Night (Back by 22:10)</div>\n```\n\n```{=html}\n<div class=\"event-card activity\" style=\"border-color:#5C6BC0;background:#F8F8FF;margin-top:24px\">\n  <div class=\"event-time\">💤</div>\n  <div class=\"event-body\">\n    <div class=\"event-tags\"><span class=\"tag activity\">😴 Jet Lag Strategy</span></div>\n    <div class=\"event-name\">Arrival Day Sleep Plan — Survive Tonight</div>\n    <div class=\"event-notes\">\n      You land at 16:05 KST but your body clock reads <strong>midnight Vancouver time</strong>. The key is to hold out until a reasonable Korean bedtime without crashing early. One bad nap now can knock your sleep schedule off for days.\n      <div style=\"margin-top:12px;display:flex;flex-direction:column;gap:0\">\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#FFEBEE;border-radius:8px 8px 0 0;border-left:4px solid #C62828\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#B71C1C\">16:05–18:00 KST<br><span style=\"font-weight:400;color:#C62828\">00:05–02:00 PDT</span></div>\n          <div><strong>⚠️ Do NOT nap</strong> — even lying down \"just for 20 min\" will become 3 hours. Get the SIM, take the bus, check in, and go straight outside. Movement helps.</div>\n        </div>\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#FFF3E0;border-left:4px solid #E65100\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#E65100\">18:00–21:00 KST<br><span style=\"font-weight:400;color:#E65100\">02:00–05:00 PDT</span></div>\n          <div><strong>Stay busy</strong> — Bright lights, food, and walking are your best friend right now. Eat a proper dinner even if you're not hungry.</div>\n        </div>\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#E8F5E9;border-left:4px solid #2E7D32\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#1B5E20\">21:00–22:00 KST<br><span style=\"font-weight:400;color:#2E7D32\">05:00–06:00 PDT</span></div>\n          <div><strong>😴 Bedtime</strong> — this is your target. Take a melatonin (0.5–1mg), shower, black out the room. Don't fight it past 22:00 — earlier is fine.</div>\n        </div>\n\n        <div style=\"display:flex;gap:12px;align-items:flex-start;padding:10px 12px;background:#E3F2FD;border-radius:0 0 8px 8px;border-left:4px solid #1565C0\">\n          <div style=\"min-width:110px;font-weight:700;font-size:12px;color:#0D47A1\">07:00–08:00 KST<br><span style=\"font-weight:400;color:#1565C0\">15:00–16:00 PDT</span></div>\n          <div><strong>Wake up</strong> — set an alarm. Your body clock will likely wake you earlier (Vancouver afternoon = Seoul early morning). Get up, open curtains, get sunlight. Day 2 starts fresh. ☀️</div>\n        </div>\n\n      </div>\n      <div style=\"margin-top:10px;font-size:12px;color:#777\">☀️ <strong>Sunlight is the strongest reset signal</strong> — get outside in the morning on Day 2 (Jul 28). Breakfast on the hotel terrace or a walk before the Gangnam day helps lock in your new rhythm.</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"note-box\"><strong>Breakfast included</strong> at hotel daily. · <strong>T-Money:</strong> comes free with your LG U+ SIM — top it up at any convenience store or subway machine.</div>\n```\n"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":true,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png